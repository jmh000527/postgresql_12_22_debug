diff -U3 /home/runner/work/postgresql_12_22_debug/postgresql_12_22_debug/src/test/regress/expected/bitmapops.out /home/runner/work/postgresql_12_22_debug/postgresql_12_22_debug/src/test/regress/results/bitmapops.out
