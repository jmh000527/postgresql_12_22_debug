-	(1, 3, 'arc 1 -> 3'),
-	(2, 3, 'arc 2 -> 3'),
-	(1, 4, 'arc 1 -> 4'),
-	(4, 5, 'arc 4 -> 5'),
-	(5, 1, 'arc 5 -> 1');
-with recursive search_graph(f, t, label, path, cycle) as (
-	select *, array[row(g.f, g.t)], false from graph g
-	union all
-	select g.*, path || row(g.f, g.t), row(g.f, g.t) = any(path)
-	from graph g, search_graph sg
-	where g.f = sg.t and not cycle
-)
