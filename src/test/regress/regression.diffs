----------------------------------------------------------------
- Aggregate
-   ->  Nested Loop
-         ->  Append
-               ->  Seq Scan on prt1_p1 t1
-               ->  Seq Scan on prt1_p2 t1_1
-               ->  Seq Scan on prt1_p3 t1_2
-         ->  Append
-               ->  Index Scan using iprt2_p1_b on prt2_p1 t2
-                     Index Cond: (b = t1.a)
-                     Filter: (t1.b = a)
-               ->  Index Scan using iprt2_p2_b on prt2_p2 t2_1
-                     Index Cond: (b = t1.a)
-                     Filter: (t1.b = a)
-               ->  Index Scan using iprt2_p3_b on prt2_p3 t2_2
-                     Index Cond: (b = t1.a)
-                     Filter: (t1.b = a)
-(16 rows)
