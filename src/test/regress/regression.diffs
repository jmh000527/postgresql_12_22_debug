-	end if;
-	if rec.slotlink = blname then
-	    update HSlot set slotlink = '''' where slotname = myname;
-	end if;
-	return 0;
-    end if;
-    if mytype = ''PH'' then
-        select into rec * from PHone where slotname = myname;
-	if not found then
-	    return 0;
-	end if;
-	if rec.slotlink = blname then
