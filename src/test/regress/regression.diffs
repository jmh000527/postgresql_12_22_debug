-SELECT p1.oid, p1.proname
-FROM pg_proc as p1
-WHERE proallargtypes IS NOT NULL AND proargnames IS NOT NULL AND
-    array_length(proallargtypes,1) <> array_length(proargnames,1);
- oid | proname 
------+---------
-(0 rows)
