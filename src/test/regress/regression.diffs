--- data modification
-CREATE TABLE fewmore AS SELECT generate_series(1,3) AS data;
-INSERT INTO fewmore VALUES(generate_series(4,5));
-SELECT * FROM fewmore;
- data 
-------
-    1
-    2
-    3
-    4
-    5
-(5 rows)
