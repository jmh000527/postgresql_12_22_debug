-DECLARE c1 CURSOR FOR SELECT * FROM ucview;
-FETCH FROM c1;
- f1 |  f2   
-----+-------
- 13 | three
-(1 row)
-
-DELETE FROM ucview WHERE CURRENT OF c1; -- fail, views not supported
-ERROR:  WHERE CURRENT OF on a view is not implemented
-ROLLBACK;
