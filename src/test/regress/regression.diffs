-         SubPlan 1 (returns $2,$3)
-           ->  Limit
-                 Output: (i_1.f1), (((i_1.f2)::text || '-'::text))
-                 ->  Seq Scan on public.int4_tbl
-                       Output: i_1.f1, ((i_1.f2)::text || '-'::text)
-   ->  Seq Scan on public.inhcld2 i_2
-         Output: $2, $3, (SubPlan 1 (returns $2,$3)), i_2.ctid
-(12 rows)
-
