-	end if;
-	if rec.slotlink = blname then
-	    update IFace set slotlink = '''' where slotname = myname;
-	end if;
-	return 0;
-    end if;
-    if mytype = ''HS'' then
-        select into rec * from HSlot where slotname = myname;
-	if not found then
