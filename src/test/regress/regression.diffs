-   |   | {"a":null,"b":null}
-(2 rows)
-
-select *, row_to_json(u) from unnest(array[null::rngfunc2, (1,'foo')::rngfunc2, null::rngfunc2]) u;
- a |  b  |     row_to_json     
----+-----+---------------------
-   |     | {"a":null,"b":null}
- 1 | foo | {"a":1,"b":"foo"}
-   |     | {"a":null,"b":null}
-(3 rows)
-
-select *, row_to_json(u) from unnest(array[]::rngfunc2[]) u;
- a | b | row_to_json 
----+---+-------------
-(0 rows)
-
-drop type rngfunc2;
