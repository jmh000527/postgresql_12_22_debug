-SELECT * FROM uctest;
- f1 |  f2   
-----+-------
-  8 | one
- 13 | three
-(2 rows)
-
-UPDATE uctest SET f1 = f1 + 10 WHERE CURRENT OF c1;
-SELECT * FROM uctest;
- f1 |  f2   
-----+-------
-  8 | one
- 23 | three
-(2 rows)
