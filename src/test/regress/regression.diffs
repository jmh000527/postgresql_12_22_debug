---
--- Test for computations in views
---
-create table rtest_comp (
-	part	text,
-	unit	char(4),
-	size	float
-);
-create table rtest_unitfact (
-	unit	char(4),
-	factor	float
-);
-create view rtest_vcomp as
-	select X.part, (X.size * Y.factor) as size_in_cm
-			from rtest_comp X, rtest_unitfact Y
-			where X.unit = Y.unit;
