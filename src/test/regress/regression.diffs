-INSERT INTO shoe_data VALUES ('sh4', 3, 'brown', 40.0, 50.0, 'inch');
-INSERT INTO shoelace_data VALUES ('sl1', 5, 'black', 80.0, 'cm');
-INSERT INTO shoelace_data VALUES ('sl2', 6, 'black', 100.0, 'cm');
