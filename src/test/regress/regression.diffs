---
--- Test for constraint updates/deletes
---
-insert into rtest_system values ('orion', 'Linux Jan Wieck');
-insert into rtest_system values ('notjw', 'WinNT Jan Wieck (notebook)');
-insert into rtest_system values ('neptun', 'Fileserver');
