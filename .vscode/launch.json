{
    "configurations": [
        {
            "name": "(gdb) 附加",
            "type": "cppdbg",
            "request": "attach",
            "program": "/home/jiminghao/build/pgbuild/bin/postgres",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "GDB 在程序调用 fork() 后，会同时调试父进程和子进程，而不会自动脱离对子进程。你可以通过命令在父进程和子进程之间切换调试",
                    "text": "-gdb-set detach-on-fork off",
                    "ignoreFailures": true
                },
                {
                    "description": "设置 -gdb-set follow-fork-mode child 后，GDB 会在程序调用 fork() 时自动跟踪子进程，而不是父进程",
                    "text": "-gdb-set follow-fork-mode child",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) 启动initdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/jiminghao/build/pgbuild/bin/initdb",
            "args": ["-D", "/home/jiminghao/code/pgdata/"],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
            ]
        }

    ]
}